    "accent": {
      "rough": {
        "name": "Ostrý přídech",
        "description": "U počáteční samohlásky se čte jako „h“. U počáteční dvojhlásky stojí přídech nad druhou samohláskou, ale „h“ se vysloví před celou dvojhláskou; např. αἱ → hai a εὑ → heu. Počáteční ρ se přepisuje jako rh.",
        "diphthongs_key": "diphthongs_with_asper",
        "rho_special": {
          "description": "Zvláštní případ: počáteční ρ s ostrým přídechem se přepisuje jako rh a toto pravidlo má přednost před obecným pravidlem přídechu.",
          "example": "Ῥόδος → Rhodos",
          "mappings_key": "initial_rho_with_asper"
        }
      },
      "smooth": {
        "name": "Jemný přídech",
        "description": "Nevyslovuje se. I u počáteční dvojhlásky se píše nad její druhou samohláskou.",
        "examples": "ἀρχή – arché; ἒφασκεν – efasken; εὐγενής – eugenés"
      }
